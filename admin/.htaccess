# ═══════════════════════════════════════════════════════════════
# Masar Admin — Access Restriction
# SECURITY: Restrict admin panel access by IP address.
# Replace YOUR_OFFICE_IP and YOUR_HOME_IP with real IPv4/IPv6 addresses.
# Multiple IPs can be listed with separate "Require ip" lines.
# ═══════════════════════════════════════════════════════════════

# Force HTTPS for admin panel
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ─── IP ALLOWLIST (recommended — uncomment and fill in real IPs) ──────────────
# <IfModule mod_authz_core.c>
#   Require ip YOUR_OFFICE_IP
#   Require ip YOUR_HOME_IP
# </IfModule>
# <IfModule !mod_authz_core.c>
#   Order deny,allow
#   Deny from all
#   Allow from YOUR_OFFICE_IP
#   Allow from YOUR_HOME_IP
# </IfModule>

# ─── SECURITY HEADERS for admin ───────────────────────────────
<IfModule mod_headers.c>
  # Do not index admin pages
  Header always set X-Robots-Tag "noindex, nofollow"
  # Stricter CSP for admin (no inline scripts)
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  # Disable browser caching of admin pages
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
</IfModule>

# ─── Disable directory listing ─────────────────────────────────
Options -Indexes

# ─── Block direct access to any non-PHP files in admin ─────────
<FilesMatch "^(?!login\.php|dashboard\.php)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
