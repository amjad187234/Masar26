# ═══════════════════════════════════════════════════════════════
# Masar Werbeagentur — Apache/LiteSpeed Server Configuration
# Hostinger shared hosting compatible
# ═══════════════════════════════════════════════════════════════

Options -Indexes -MultiViews
ServerSignature Off

# ─── REWRITE ENGINE ────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Force www → non-www (choose one direction and stick with it)
  RewriteCond %{HTTP_HOST} ^www\.masar-werbeagentur\.de$ [NC]
  RewriteRule ^ https://masar-werbeagentur.de%{REQUEST_URI} [R=301,L]

  # Clean URL: /qr/ → /qr/index.html (handled by DirectoryIndex, but explicit fallback)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^qr/?$ /qr/index.html [L]

  # Block access to sensitive files
  RewriteRule ^\.env$              - [F,L]
  RewriteRule ^\.git(/|$)          - [F,L]
  RewriteRule ^composer\.(json|lock)$ - [F,L]
</IfModule>

# ─── DIRECTORY INDEX ───────────────────────────────────────────
DirectoryIndex index.html index.php

# ─── SECURITY HEADERS ──────────────────────────────────────────
<IfModule mod_headers.c>
  # HSTS — browsers remember HTTPS for 1 year (+ subdomains + preload)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"

  # Clickjacking prevention
  Header always set X-Frame-Options "SAMEORIGIN"

  # MIME sniffing prevention
  Header always set X-Content-Type-Options "nosniff"

  # XSS filter (legacy browsers)
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy — disable unused browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; base-uri 'self';"

  # Remove server signature headers
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

# ─── BROTLI COMPRESSION ────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# ─── GZIP COMPRESSION (fallback if Brotli not available) ───────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff font/woff2
  # Remove buggy browser compression
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent
</IfModule>

# ─── BROWSER CACHING ───────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — no cache (always fresh content)
  ExpiresByType text/html                    "access plus 0 seconds"

  # CSS & JavaScript — 1 year (cache-busted via filenames in production)
  ExpiresByType text/css                     "access plus 1 year"
  ExpiresByType application/javascript       "access plus 1 year"
  ExpiresByType text/javascript              "access plus 1 year"

  # Fonts — 1 year (rarely change)
  ExpiresByType font/woff2                   "access plus 1 year"
  ExpiresByType font/woff                    "access plus 1 year"
  ExpiresByType font/ttf                     "access plus 1 year"
  ExpiresByType application/font-woff        "access plus 1 year"
  ExpiresByType application/font-woff2       "access plus 1 year"

  # Images — 6 months
  ExpiresByType image/jpeg                   "access plus 6 months"
  ExpiresByType image/png                    "access plus 6 months"
  ExpiresByType image/gif                    "access plus 6 months"
  ExpiresByType image/webp                   "access plus 6 months"
  ExpiresByType image/avif                   "access plus 6 months"
  ExpiresByType image/svg+xml                "access plus 6 months"
  ExpiresByType image/x-icon                 "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon     "access plus 1 year"

  # Documents
  ExpiresByType application/pdf              "access plus 1 month"

  # Manifest & data
  ExpiresByType application/manifest+json    "access plus 1 week"
  ExpiresByType application/json             "access plus 0 seconds"
  ExpiresByType text/xml                     "access plus 0 seconds"
  ExpiresByType application/xml              "access plus 0 seconds"
</IfModule>

# ─── CACHE-CONTROL HEADERS ─────────────────────────────────────
<IfModule mod_headers.c>
  # HTML: no-store prevents stale pages
  <FilesMatch "\.(html|htm|php)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
  </FilesMatch>

  # Static assets: immutable for 1 year
  <FilesMatch "\.(css|js|woff|woff2|ttf|otf)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images: 6 months
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|avif|svg)$">
    Header always set Cache-Control "public, max-age=15552000"
  </FilesMatch>

  # Fonts: ensure correct CORS for cross-origin font requests
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ─── FILE ACCESS RESTRICTIONS ──────────────────────────────────
<FilesMatch "(^\.htaccess|\.htpasswd|\.env|composer\.(json|lock)|package(-lock)?\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ─── PHP SECURITY (Hostinger PHP 8.x) ─────────────────────────
<IfModule mod_php.c>
  php_flag display_errors Off
  php_flag log_errors On
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
  php_value max_execution_time 30
  php_value max_input_time 30
</IfModule>

# ─── CUSTOM ERROR PAGES ────────────────────────────────────────
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# ─── MIME TYPES ────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType font/woff2                        .woff2
  AddType font/woff                         .woff
  AddType image/webp                        .webp
  AddType image/avif                        .avif
  AddType application/manifest+json         .webmanifest
</IfModule>
